---
import { url } from '../lib/url';
interface Props { title: string; description?: string }
const { title, description = 'A filterable atlas of regional cuisine, recipes, dish stories and food festivals.' } = Astro.props;
const full = title === 'For the Love of Food' ? title : `${title} · For the Love of Food`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{full}</title>
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={url('/')}>For the Love of Food</a>
        <nav aria-label="Main">
          <a href={url('/dishes/')}>Dishes</a>
          <a href={url('/countries/')}>Countries</a>
          <a href={url('/festivals/')}>Festivals</a>
        </nav>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <p>Draft content: stories and recipes are AI-drafted and awaiting human review. Sources are cited on each page.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbf8f3; --surface: #ffffff; --text: #231f1b; --muted: #6b625a;
    --border: #e4dccf; --accent: #b4441f; --accent-ink: #ffffff; --chip: #f1e9db;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #181512; --surface: #221e1a; --text: #f1ebe2; --muted: #a79d91;
      --border: #3a342d; --accent: #e8794f; --accent-ink: #1a0f08; --chip: #302a24;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.6 system-ui, -apple-system, 'Segoe UI', sans-serif; }
  a { color: var(--accent); }
  h1, h2, h3 { line-height: 1.2; }
  h1 { font-size: 2rem; margin: 1.5rem 0 .5rem; }
  h2 { font-size: 1.35rem; margin: 2rem 0 .5rem; }
  .wrap { max-width: 1100px; margin: 0 auto; padding: 0 16px; }
  .site-header { border-bottom: 1px solid var(--border); background: var(--surface); }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-top: 12px; padding-bottom: 12px; flex-wrap: wrap; }
  .brand { font-weight: 700; font-size: 1.15rem; text-decoration: none; color: var(--text); }
  nav a { margin-left: 16px; text-decoration: none; font-weight: 600; }
  .site-footer { margin-top: 3rem; padding: 1.5rem 0; border-top: 1px solid var(--border); color: var(--muted); font-size: .9rem; }
  .muted { color: var(--muted); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: .5rem 0; list-style: none; }
  .chip { background: var(--chip); border-radius: 999px; padding: 2px 10px; font-size: .8rem; text-decoration: none; color: var(--text); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 16px; padding: 0; list-style: none; }
  .card { position: relative; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 16px; }
  .card h3 { margin: 0 0 .25rem; font-size: 1.1rem; }
  .card h3 a { text-decoration: none; color: var(--text); }
  .card h3 a::after { content: ''; position: absolute; inset: 0; }
  .card p { margin: .4rem 0; font-size: .92rem; }
  .card .fav { position: relative; z-index: 1; }
  .fav { position: absolute; top: 8px; right: 8px; background: none; border: 0; font-size: 1.3rem; cursor: pointer; color: var(--muted); line-height: 1; padding: 4px; }
  .fav[aria-pressed="true"] { color: var(--accent); }
  table { border-collapse: collapse; width: 100%; }
  td, th { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--border); vertical-align: top; }
  .callout { border-left: 4px solid var(--accent); background: var(--chip); padding: .6rem 1rem; border-radius: 0 8px 8px 0; margin: 1rem 0; }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
</style>
