{
  "name": "for-the-love-of-food",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "validate": "python3 scripts/validate.py",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:import": "tsx db/import.ts",
    "db:smoke": "tsx db/smoke.ts",
    "app:dev": "astro dev --root app",
    "app:build": "astro build --root app",
    "app:start": "node app/dist/server/entry.mjs",
    "app:test": "tsx --test app/test/app.test.ts",
    "app:vercel-build": "astro build --root app && node scripts/place-vercel-output.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/vercel": "^11.0.18",
    "@electric-sql/pglite": "^0.5.14",
    "astro": "^7.4.5",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.0.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  },
  "engines": {
    "node": "22.x"
  }
}
