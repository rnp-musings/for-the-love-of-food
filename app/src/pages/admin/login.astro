---
import Base from '../../layouts/Base.astro';
import { adminEnabled, checkToken, isAdmin, startSession, throttled } from '../../lib/auth';

if (!adminEnabled()) return Astro.rewrite('/404');
if (isAdmin(Astro.cookies)) return Astro.redirect('/admin');

let error = '';
if (Astro.request.method === 'POST') {
  if (throttled(Astro.clientAddress ?? 'unknown')) {
    error = 'Too many attempts. Wait ten minutes and try again.';
  } else {
    const form = await Astro.request.formData();
    const token = String(form.get('token') ?? '');
    const reviewer = String(form.get('reviewer') ?? '').trim().slice(0, 80);
    if (!reviewer) error = 'Enter your name so reviews can be attributed.';
    else if (!checkToken(token)) error = 'That token is not correct.';
    else {
      startSession(Astro.cookies);
      Astro.cookies.set('ftlof_reviewer', reviewer, { sameSite: 'strict', path: '/', maxAge: 60 * 60 * 24 * 30 });
      return Astro.redirect('/admin');
    }
  }
}
---
<Base title="Admin sign-in" noindex>
  <h1>Reviewer sign-in</h1>
  <form method="post" class="filters" style="max-width:28rem">
    <div class="row"><label class="wide">Your name<input name="reviewer" required maxlength="80" autocomplete="name" /></label></div>
    <div class="row"><label class="wide">Admin token<input name="token" type="password" required autocomplete="current-password" /></label></div>
    {error && <p class="callout" role="alert">{error}</p>}
    <button class="btn" type="submit">Sign in</button>
  </form>
</Base>
