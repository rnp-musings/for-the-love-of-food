{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "country.schema.json",
  "title": "Country",
  "type": "object",
  "required": ["id", "name", "iso2", "continent", "summary", "regional_variation"],
  "additionalProperties": false,
  "properties": {
    "id": {"$ref": "#/$defs/slug"},
    "name": {"type": "string"},
    "local_name": {"type": "string"},
    "iso2": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "continent": {"enum": ["africa", "asia", "europe", "north-america", "south-america", "oceania"]},
    "summary": {"type": "string", "description": "2-4 sentence overview of the cuisine."},
    "regional_variation": {"type": "string", "description": "Why and how cuisine varies by region within this country."},
    "review_status": {"$ref": "#/$defs/review_status"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/slug"}}
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "review_status": {"enum": ["draft", "reviewed", "published"]}
  }
}
