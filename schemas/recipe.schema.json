{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recipe.schema.json",
  "title": "Recipe",
  "type": "object",
  "required": ["id", "dish", "title", "servings", "prep_minutes", "cook_minutes", "difficulty", "ingredients", "steps", "review_status"],
  "additionalProperties": false,
  "properties": {
    "id": {"$ref": "#/$defs/slug"},
    "dish": {"$ref": "#/$defs/slug"},
    "title": {"type": "string"},
    "version": {"enum": ["traditional", "home", "quick"], "default": "home"},
    "servings": {"type": "integer", "minimum": 1},
    "prep_minutes": {"type": "integer", "minimum": 0},
    "cook_minutes": {"type": "integer", "minimum": 0},
    "passive_minutes": {"type": "integer", "minimum": 0, "description": "Marinating, proving, resting, fermenting."},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ingredient", "amount", "unit"],
        "additionalProperties": false,
        "properties": {
          "ingredient": {"$ref": "#/$defs/slug"},
          "amount": {"type": ["number", "null"], "description": "null when the unit is to-taste."},
          "unit": {"enum": ["g", "kg", "ml", "l", "tsp", "tbsp", "cup", "piece", "clove", "pinch", "bunch", "to-taste"]},
          "note": {"type": "string"},
          "optional": {"type": "boolean"},
          "group": {"type": "string", "description": "Sub-heading such as 'Marinade' or 'Sauce'."}
        }
      }
    },
    "steps": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "notes": {"type": "string"},
    "licence": {"type": "string", "default": "CC-BY-4.0 (original text)"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/slug"}},
    "review_status": {"enum": ["draft", "reviewed", "published"]}
  },
  "$defs": {"slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}}
}
